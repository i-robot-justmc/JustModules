<!DOCTYPE html>
<html>
<head>
    <title>JustMC Catalog</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="sidebar">
        <div class="logo">⚡ JUSTMC</div>
        <a href="/">🏠 Главная</a>
        <% if (user) { %>
            <a href="/profile">👤 Профиль</a>
            <a href="/profile/upload">📤 Загрузить модуль</a>
            <a href="/auth/logout">🚪 Выйти</a>
        <% } else { %>
            <a href="/auth/discord">🔑 Войти через Discord</a>
        <% } %>
    </div>
    <div class="main-content">
        <%- body %>
    </div>
</body>
</html>